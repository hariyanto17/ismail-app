datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  QRIS
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  username     String        @unique
  password     String
  full_name    String
  role         Role
  transactions Transaction[]
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  @@map("users")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @unique
  products   Product[]
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id                String            @id @default(uuid()) @db.Uuid
  category_id       String            @db.Uuid
  category          Category          @relation(fields: [category_id], references: [id], onDelete: Cascade)
  name              String            @unique
  price             Int
  is_active         Boolean           @default(true)
  image_url         String?
  transaction_items TransactionItem[]
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  @@map("products")
}

model Transaction {
  id             String            @id @default(uuid()) @db.Uuid
  invoice_number String            @unique
  cashier_id     String            @db.Uuid
  cashier        User              @relation(fields: [cashier_id], references: [id])
  payment_method PaymentMethod
  total          Int
  paid_amount    Int
  change_amount  Int
  items          TransactionItem[]
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  @@map("transactions")
}

model TransactionItem {
  id             String      @id @default(uuid()) @db.Uuid
  transaction_id String      @db.Uuid
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  product_id     String      @db.Uuid
  product        Product     @relation(fields: [product_id], references: [id])
  qty            Int
  price          Int
  subtotal       Int
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  @@map("transaction_items")
}

enum ReportType {
  DAILY
  CLOSING
  ALL
}

model AppSetting {
  id            String            @id @default(uuid()) @db.Uuid
  store_name    String            @default("Kopi Wara")
  store_address String            @default("")
  store_phone   String            @default("")
  instagram     String            @default("")
  opening_time  String            @default("09:00")
  closing_time  String            @default("23:00")
  closing_day   Int               @default(25)
  timezone      String            @default("Asia/Makassar")
  currency      String            @default("IDR")
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  recipients    ReportRecipient[]

  @@map("app_settings")
}

model ReportRecipient {
  id             String     @id @default(uuid()) @db.Uuid
  app_setting_id String     @db.Uuid
  appSetting     AppSetting @relation(fields: [app_setting_id], references: [id], onDelete: Cascade)
  name           String
  phone          String
  report_type    ReportType
  is_active      Boolean    @default(true)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  @@index([app_setting_id])
  @@index([report_type])
  @@map("report_recipients")
}

enum ReportStatus {
  SUCCESS
  FAILED
}

model ReportLog {
  id             String       @id @default(uuid()) @db.Uuid
  report_type    ReportType
  recipient      String
  recipient_name String?
  message        String
  status         ReportStatus
  error_message  String?
  sent_at        DateTime?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  @@map("report_logs")
}
